# Copier en .env.local pour le développement. Aucune valeur secrète ici.

# Fichier JSON des commerces (hôte, thème, boîtes). Hors dépôt en production.
# Sans valeur en développement : config/commerces.local.json, sinon config/commerces.exemple.json.
BOITE_COMMERCES_FICHIER=config/commerces.local.json

# Dossier privé des logos et icônes des commerces, servis par /marque/<commerce>/<fichier>.
# Hors dépôt en production. En développement, à défaut : config/marques (ignoré par git).
BOITE_MARQUES_DOSSIER=

# Source des données : demo (en mémoire) ou core-comms.
BOITE_SOURCE=demo
# Dossier privé des données de démonstration des commerces (<slug>.json). En développement, à défaut : config/demo.
BOITE_DEMO_DOSSIER=

# Clé de signature du cookie de session (32 caractères au moins). Obligatoire en production.
# En développement, sans valeur, une clé aléatoire est tirée à chaque démarrage.
BOITE_SESSION_CLE=

# Connexion : demo (bouton « Entrer », sans mot de passe) ou core-auth (comptes du commerce).
BOITE_AUTH=demo
# Adresse de core_auth (en production sur le VPS : http://127.0.0.1:3102).
CORE_AUTH_URL=
# Clé d'application core_auth de la boîte (envoyée en X-Core-Key). Jamais dans le dépôt.
CORE_AUTH_API_KEY=

# API core_comms (nécessaire avec BOITE_SOURCE=core-comms et BOITE_AUTH=core-auth).
# COMMS_URL=
# COMMS_MAIL_APP_KEY=
